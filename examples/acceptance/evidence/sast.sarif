{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "acme-sast",
          "version": "4.2.0",
          "informationUri": "https://appsec.acme.example/sast",
          "rules": [
            {
              "id": "PY-LOG-PII",
              "shortDescription": {
                "text": "a log call formats a request object"
              }
            },
            {
              "id": "PY-REQ-TIMEOUT",
              "shortDescription": {
                "text": "an HTTP call has no timeout"
              }
            }
          ]
        }
      },
      "invocations": [
        {
          "executionSuccessful": true
        }
      ],
      "versionControlProvenance": [
        {
          "repositoryUri": "https://github.com/acme/refunds-agent",
          "revisionId": "e41c07b9a3d2"
        }
      ],
      "results": [
        {
          "ruleId": "PY-REQ-TIMEOUT",
          "level": "note",
          "message": {
            "text": "client.chat.completions.create sets timeout=30; reported for review of the retry policy"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": "agent/refunds_agent.py"
                },
                "region": {
                  "startLine": 72
                }
              }
            }
          ]
        }
      ]
    }
  ]
}
